                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/requests/{id}/history": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "申请单 ID。",
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      ],
      "get": {
        "tags": [
          "审批"
        ],
        "summary": "查看操作历史",
        "operationId": "getRequestHistory",
        "description": "仅申请人或指定的一级、二级审批人可查看；无关用户返回 403。 按 operated_at 升序、id 升序排列。",
        "responses": {
          "200": {
            "description": "操作历史列表。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OperationHistory"
                  }
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效的认证凭据。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "当前用户无权执行此操作。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "申请单不存在。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "username": {
            "type": "string",
            "maxLength": 150,
            "description": "账号（username），最长 150，仅允许 Unicode 字母、数字及 @ . + - _。"
          },
          "display_name": {
            "type": "string",
            "maxLength": 150,
            "description": "昵称（display_name），最长 150。"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "display_name"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "description": "必填且唯一；账号（username），最长 150，仅允许 Unicode 字母、数字及 @ . + - _。"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "format": "password",
            "writeOnly": true,
            "description": "必填；至少 8 位，包含大写字母、小写字母、数字、符号中的至少两类，且须通过项目已配置的 Django 密码校验（不能是常见密码、不与账号过于相似）。"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "description": "必填；昵称（display_name），去除首尾空白后不能为空，最长 150。"
          }
        },
        "additionalProperties": false,
        "required": [
          "username",
          "password",
          "display_name"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "format": "password",
            "writeOnly": true,
            "description": "必填；凭据错误时统一返回 400，不区分账号不存在与密码错误。"
          }
        },
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT Bearer 访问令牌。"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type"
        ]
      },
      "DraftInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": ".*\\S.*",
            "description": "去除首尾空白后不能为空。"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*",
            "description": "去除首尾空白后不能为空。"
          },
          "first_approver_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "second_approver_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "content",
          "first_approver_id",
          "second_approver_id"
        ],
        "description": "创建和完整更新草稿时使用；两级审批人须存在且均不能是申请人。"
      },
      "ApprovalInput": {
        "type": "object",
        "properties": {
          "expected_step": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1 为一级审批，2 为二级审批。"
          },
          "comment": {
            "type": "string",
            "maxLength": 500,
            "description": "通过时可省略或为空。"
          }
        },
        "additionalProperties": false,
        "required": [
          "expected_step"
        ],
        "description": "expected_step 是客户端针对所见节点的前置条件；服务器必须依据数据库当前状态、步骤及审批人授权，并在事务内比较该值，不得据此前进到指定节点。重试必须保留原值；不一致返回 409。"
      },
      "RejectionInput": {
        "type": "object",
        "properties": {
          "expected_step": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1 为一级审批，2 为二级审批。"
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*",
            "description": "去除首尾空白后不能为空。"
          }
        },
        "additionalProperties": false,
        "required": [
          "expected_step",
          "comment"
        ],
        "description": "expected_step 为前置条件，服务端须在事务内与当前步骤比较。"
      },
      "ApprovalRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "content": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved",
              "rejected"
            ],
            "description": "分别表示草稿、审批中、已通过、已驳回。"
          },
          "applicant": {
            "$ref": "#/components/schemas/User"
          },
          "first_approver": {
            "$ref": "#/components/schemas/User"
          },
          "second_approver": {
            "$ref": "#/components/schemas/User"
          },
          "current_step": {
            "type": "integer",
            "enum": [
              1,
              2,
              null
            ],
            "nullable": true,
            "description": "1 为一级审批，2 为二级审批；无当前步骤时为 null。"
          },
          "current_approver": {
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ],
            "nullable": true,
            "description": "根据状态和当前步骤计算；无当前审批人时为 null。"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 时间，包含时区。"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 时间，包含时区。"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "content",
          "status",
          "applicant",
          "first_approver",
          "second_approver",
          "current_step",
          "current_approver",
          "created_at",
          "updated_at",
          "submitted_at"
        ],
        "description": "申请人和两级审批人以用户摘要表示；历史通过详情附带或历史接口获取。"
      },
      "ApprovalRequestDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "content": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved",
              "rejected"
            ],
            "description": "分别表示草稿、审批中、已通过、已驳回。"
          },
          "applicant": {
            "$ref": "#/components/schemas/User"
          },
          "first_approver": {
            "$ref": "#/components/schemas/User"
          },
          "second_approver": {
            "$ref": "#/components/schemas/User"
          },
          "current_step": {
            "type": "integer",
            "enum": [
              1,
              2,
              null
            ],
            "nullable": true,
            "description": "1 为一级审批，2 为二级审批；无当前步骤时为 null。"
          },
          "current_approver": {
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ],
            "nullable": true,
            "description": "根据状态和当前步骤计算；无当前审批人时为 null。"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 时间，包含时区。"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 时间，包含时区。"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationHistory"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "content",
          "status",
          "applicant",
          "first_approver",
          "second_approver",
          "current_step",
          "current_approver",
          "created_at",
          "updated_at",
          "submitted_at",
          "history"
        ]
      },
      "OperationHistory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "request_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "operator": {
            "$ref": "#/components/schemas/User"
          },
          "action": {
            "type": "string",
            "enum": [
              "submit",
              "approve",
              "reject"
            ]
          },
          "step": {
            "type": "integer",
            "enum": [
              1,
              2,
              null
            ],
            "nullable": true,
            "description": "1 为一级审批，2 为二级审批；无当前步骤时为 null。"
          },
          "comment": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "before_status": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved",
              "rejected"
            ],
            "description": "分别表示草稿、审批中、已通过、已驳回。"
          },
          "before_step": {
            "type": "integer",
            "enum": [
              1,
              2,
              null
            ],
            "nullable": true,
            "description": "1 为一级审批，2 为二级审批；无当前步骤时为 null。"
          },
          "after_status": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved",
              "rejected"
            ],
            "description": "分别表示草稿、审批中、已通过、已驳回。"
          },
          "after_step": {
            "type": "integer",
            "enum": [
              1,
              2,
              null
            ],
            "nullable": true,
            "description": "1 为一级审批，2 为二级审批；无当前步骤时为 null。"
          },
          "operated_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 时间，包含时区。"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "request_id",
          "operator",
          "action",
          "step",
          "comment",
          "before_status",
          "before_step",
          "after_status",
          "after_step",
          "operated_at"
        ],
        "description": "提交时 step 和 comment 为 null；审批时 step 为 1 或 2，驳回时 comment 非空。"
      },
      "RequestPage": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "符合筛选条件的总条数。"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprovalRequest"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "count",
          "page",
          "page_size",
          "results"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "稳定的机器可读错误码。当前接口使用 validation_error、invalid_credentials、unauthorized、scope_not_available、conflict、forbidden、not_found、internal_error。"
          },
          "message": {
            "type": "string",
            "description": "可展示给用户的错误信息。"
          },
          "details": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "可选的字段级校验信息；不得包含敏感数据。"
          }
        },
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
