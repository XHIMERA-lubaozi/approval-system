    "/api/requests": {
      "get": {
        "tags": [
          "申请单"
        ],
        "summary": "查询申请列表",
        "operationId": "listRequests",
        "description": "仅返回 scope 对应的申请；pending 仅包含当前需要本人处理的申请。支持状态与标题关键词筛选。",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "mine",
                "pending"
              ],
              "default": "mine"
            },
            "description": "mine 为我发起的；pending 为待我审批。本轮仅开放 mine，pending 返回 400。"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "页码，从 1 开始。"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "description": "每页条数。"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "in_review",
                "approved",
                "rejected"
              ],
              "description": "分别表示草稿、审批中、已通过、已驳回。"
            },
            "description": "按申请状态筛选。"
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "按标题关键词搜索，最长 100 个字符。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestPage"
                }
              }
            }
          },
          "400": {
            "description": "参数不合法或凭据错误。",
