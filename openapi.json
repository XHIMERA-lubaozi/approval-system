{
  "openapi": "3.0.3",
  "info": {
    "title": "简易审批流系统 API",
    "version": "1.0.0",
    "description": "基于 doc/Spec.md 和 doc/ER图.md 的接口设计，共 13 个操作。当前已实现注册、登录、获取当前用户、审批人候选列表，以及草稿创建、列表、详情、更新和删除（共 9 个操作）以及统一错误结构；提交、审批和历史接口为后续阶段设计草案。JSON 请求和响应使用 UTF-8；字段采用 snake_case（查询参数 pageSize 沿用 Spec）。业务接口使用 JWT Bearer。所有非 2xx 响应使用统一 Error 结构；内部错误不返回敏感信息。日期时间使用带时区的 RFC 3339 格式。审批的 expected_step 是防止旧请求误推进下一节点的前置条件，并非由客户端决定当前步骤。认证相关字段约束已与实际实现同步：账号（username）最长 150 且仅允许 Unicode 字母、数字及 @ . + - _；昵称（display_name）最长 150；注册密码至少 8 位、包含大写字母、小写字母、数字、符号中的至少两类，并通过 Django 已配置的密码校验。"
  },
  "servers": [
    {
      "url": "/",
      "description": "当前服务根路径"
    }
  ],
  "tags": [
    {
      "name": "认证"
    },
    {
      "name": "用户"
    },
    {
      "name": "申请单"
    },
    {
      "name": "审批"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
